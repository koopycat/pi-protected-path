{
	"name": "pi-protected-path",
	"version": "0.1.0",
	"type": "module",
	"description": "Pi extension that requires approval before agents access sensitive project files matched by .agentignore patterns.",
	"keywords": [
		"pi-package",
		"pi-extension",
		"security",
		"access-control",
		"secrets"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+ssh://git@github.com/koopycat/pi-protected-path.git"
	},
	"engines": {
		"node": ">=22"
	},
	"pi": {
		"extensions": [
			"./index.ts"
		]
	},
	"scripts": {
		"test": "vitest --run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit",
		"lint": "eslint . --max-warnings 0",
		"lint:fix": "eslint --fix .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"check": "prettier --check . && eslint . --max-warnings 0 && tsc --noEmit && vitest --run"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "^0.87.1",
		"@types/node": "^26.0.0",
		"eslint": "^10.6.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-import-x": "^4.17.1",
		"eslint-plugin-n": "^18.2.1",
		"prettier": "^3.9.5",
		"typescript": "^5.9.0",
		"typescript-eslint": "^8.63.0",
		"vitest": "^3.2.0"
	}
}
